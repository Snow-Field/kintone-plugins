{
  "name": "api-proxy",
  "version": "1.0.0",
  "description": "",
  "author": "Masanobu Sunohara",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "init": "run-s init:env init:key",
    "init:env": "kintone-plugin-dotenv",
    "init:key": "kintone-plugin-genkey",
    "dev": "cross-env NODE_ENV=development run-s bundle package upload",
    "build": "cross-env NODE_ENV=production run-s bundle package",
    "bundle": "rsbuild build",
    "package": "cli-kintone plugin pack --input dist/manifest.json --private-key private.ppk --output artifacts/plugin.zip",
    "upload": "kintone-plugin-upload",
    "deploy": "run-s build upload",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist artifacts .turbo"
  },
  "dependencies": {
    "@kintone-plugin/plugin-shell": "workspace:*",
    "@kintone-plugin/ui": "workspace:*",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "jotai": "catalog:",
    "nanoid": "catalog:",
    "notistack": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kintone-plugin/kintone-utils": "workspace:*",
    "@kintone-plugin/plugin-scripts": "workspace:*",
    "@kintone-plugin/tsconfig": "workspace:*",
    "@kintone/cli": "catalog:",
    "@kintone/dts-gen": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsbuild/plugin-type-check": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cross-env": "catalog:",
    "fs-extra": "catalog:",
    "npm-run-all": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
