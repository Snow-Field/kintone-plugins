{
  "name": "@kintone-plugin/kintone-utils",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "scripts": {
    "lint": "run-p lint:*",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier --check src",
    "fix": "run-p fix:*",
    "fix:eslint": "eslint --fix src",
    "fix:prettier": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .turbo dist"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@kintone/rest-api-client": "catalog:",
    "jotai": "catalog:",
    "notistack": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@kintone-plugin/eslint-config": "workspace:*",
    "@kintone-plugin/tsconfig": "workspace:*",
    "@kintone/dts-gen": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "npm-run-all": "catalog:",
    "typescript": "catalog:"
  }
}
