{
  "name": "kintone-plugins",
  "version": "1.0.0",
  "description": "kintone Plugins Monorepo",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!plugin-starter",
    "dev": "turbo run dev --filter=!plugin-starter",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "gen": "node scripts/create-plugin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@clack/prompts": "^0.11.0",
    "fs-extra": "^11.4.1",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  }
}
